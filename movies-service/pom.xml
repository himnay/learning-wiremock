<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <parent>
        <groupId>com.learnwiremock</groupId>
        <artifactId>learning-wiremock</artifactId>
        <version>1.0.0-SNAPSHOT</version>
    </parent>

    <artifactId>movies-service</artifactId>
    <packaging>jar</packaging>
    <name>movies-service</name>
    <description>Movies REST API — in-memory CRUD service consumed by movies-client</description>

    <dependencies>

        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-web</artifactId>
        </dependency>
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-validation</artifactId>
        </dependency>
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-actuator</artifactId>
        </dependency>

        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-devtools</artifactId>
            <scope>runtime</scope>
            <optional>true</optional>
        </dependency>
        <dependency>
            <groupId>org.projectlombok</groupId>
            <artifactId>lombok</artifactId>
            <optional>true</optional>
        </dependency>

        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-test</artifactId>
            <scope>test</scope>
        </dependency>
        <!-- Runtime support for the verification tests generated from src/test/resources/contracts
             (RestAssured MockMvc, JsonAssert, …) — version managed by spring-cloud-dependencies BOM -->
        <dependency>
            <groupId>org.springframework.cloud</groupId>
            <artifactId>spring-cloud-starter-contract-verifier</artifactId>
            <scope>test</scope>
        </dependency>

    </dependencies>

    <build>
        <plugins>
            <!-- Producer side of Spring Cloud Contract:
                 1. generates a JUnit 5 test per contract, extending ContractVerifierBase
                 2. runs them against the REAL MovieController via RestAssuredMockMvc
                 3. packages the equivalent WireMock mappings as movies-service-<version>-stubs.jar
                 Plugin version must match the spring-cloud-contract.version managed by
                 spring-cloud-dependencies 2025.1.2 (learning-bom) = 5.0.3 -->
            <plugin>
                <groupId>org.springframework.cloud</groupId>
                <artifactId>spring-cloud-contract-maven-plugin</artifactId>
                <version>5.0.3</version>
                <extensions>true</extensions>
                <configuration>
                    <testFramework>JUNIT5</testFramework>
                    <baseClassForTests>com.learnwiremock.movies.ContractVerifierBase</baseClassForTests>
                </configuration>
            </plugin>
        </plugins>
    </build>

</project>
