<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <parent>
        <groupId>com.org.llm</groupId>
        <artifactId>super-pom</artifactId>
        <version>1.1.2</version>
    </parent>

    <groupId>com.learnwiremock</groupId>
    <artifactId>learning-wiremock</artifactId>
    <version>1.0.0-SNAPSHOT</version>
    <packaging>pom</packaging>
    <name>learning-wiremock</name>
    <description>Learning WireMock with Spring Boot — stubs, response templates, fault simulation, and selective proxying</description>

    <properties>
        <java.version>25</java.version>
        <spring-cloud-contract.version>5.0.3</spring-cloud-contract.version>
    </properties>

    <!-- Spring Cloud 2025.1.3 (via learning-bom) no longer imports Spring Cloud Contract into the
         release-train BOM (2025.1.2 still did), so manage it here — this repo is its only user. -->
    <dependencyManagement>
        <dependencies>
            <dependency>
                <groupId>org.springframework.cloud</groupId>
                <artifactId>spring-cloud-contract-dependencies</artifactId>
                <version>${spring-cloud-contract.version}</version>
                <type>pom</type>
                <scope>import</scope>
            </dependency>
        </dependencies>
    </dependencyManagement>

    <modules>
        <!-- producer first: movies-client's contract test resolves movies-service-*-stubs.jar
             from the local repository (StubsMode.LOCAL), so it must be installed before the client runs -->
        <module>movies-service</module>
        <module>movies-client</module>
    </modules>

</project>
